{
  "description": "Local fork wiki hooks, built from the current CLI source without an npm download.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/wiki-context.mjs\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/wiki-context.mjs\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
