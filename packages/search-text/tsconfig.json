{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "lib": [
      "ES2022",
      "ES2022.Intl",
      "DOM"
    ],
    "types": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "dist"
  ]
}
